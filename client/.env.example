# Client (local dev uses environment.development.ts via ng serve)
API_URL=http://localhost:3001/api
SOCKET_URL=http://localhost:3001

# Production build (scripts/generate-environment.mjs) — set on Render static site:
# API_HOST=<group-chat-api host from Render>
# API_URL=https://<api-host>/api          (optional override)
# SOCKET_URL=https://<api-host>            (optional override)
# GOOGLE_CLIENT_ID=<same as server>
