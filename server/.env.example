# Server
PORT=3001
NODE_ENV=development

# MongoDB Atlas — replace placeholders with your cluster credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/group-chat-db?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRES_IN=7d

# Upload limits
MAX_FILE_SIZE_MB=10

# Cloudinary — file uploads (images, audio, pdf)
# Get these from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client origin (CORS)
CLIENT_ORIGIN=http://localhost:4200

# Google Sign-In — OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Gemini (AI agent) — get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
