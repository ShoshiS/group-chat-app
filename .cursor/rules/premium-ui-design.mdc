## Design tokens

```scss
:root {
  // Brand
  --brand: #00b074;
  --brand-light: #eefcf7;
  --brand-tint: #3eb489;
  --brand-dark: #00905e;
  --brand-soft-bg: #f4f7f6;

  // Surfaces
  --app-bg: #eef2f5;
  --panel-bg: #ffffff;
  --main-bg: #f1f5f9;
  --card-bg: rgba(248, 250, 252, 0.4);
  --card-border: rgba(255, 255, 255, 0.6);

  // Chat bubbles
  --bubble-self: #e1e3f0;
  --bubble-other: #ffffff;

  // Text
  --text-body: #334155;
  --text-heading: #1e293b;
  --text-muted: #94a3b8;
  --text-subtle: #64748b;

  // Borders
  --border-light: #f1f5f9;
  --border-default: #e2e8f0;

  // Status
  --status-online: #10b981;
  --status-busy: #ef4444;
  --status-away: #fbbf24;
  --status-offline: #cbd5e1;

  // Layout widths (fixed columns)
  --nav-strip-width: 70px;
  --chat-list-width: 340px;
  --files-strip-width: 85px;
  --shell-max-width: 1440px;
  --shell-height: 90vh;

  // Shadows
  --shadow-premium: 0 10px 40px -10px rgba(0, 176, 116, 0.08);
  --shadow-card: 0 20px 50px rgba(100, 116, 139, 0.12);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
  --shadow-inner: inset 0 2px 4px rgba(0, 0, 0, 0.04);

  // Radius
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-2xl: 32px;
  --radius-full: 9999px;

  // Spacing (4px base)
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;

  // Transitions
  --transition-fast: 150ms ease;
  --transition-base: 200ms ease;
  --transition-slow: 300ms ease;

  // Frosted glass
  --frosted-bg: rgba(255, 255, 255, 0.8);
  --frosted-blur: blur(12px);
}
